@model List<Leavemate.Models.Leavecls>

<h2>Manage Leave Applications</h2>

@if (TempData["msg"] != null)
{
    <p>@TempData["msg"]</p>
}

<br />

<!-- Status Filter -->

<form asp-controller="Admin"
      asp-action="ManageLeavesLoad"
      asp-route-id="@ViewBag.AdminId"
      method="get">

    <label>Filter by Status:</label>

    <select name="status">
        <option value="All"
                selected="@(ViewBag.SelectedStatus == "All")">
            All
        </option>

        <option value="Pending"
                selected="@(ViewBag.SelectedStatus == "Pending")">
            Pending
        </option>

        <option value="Approved"
                selected="@(ViewBag.SelectedStatus == "Approved")">
            Approved
        </option>

        <option value="Rejected"
                selected="@(ViewBag.SelectedStatus == "Rejected")">
            Rejected
        </option>
    </select>

    <button type="submit">Filter</button>
</form>

<br />

<table border="1" cellpadding="10" cellspacing="0">

    <tr>
        <th>Leave ID</th>
        <th>Employee ID</th>
        <th>Employee Name</th>
        <th>Department</th>
        <th>Leave Type</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Total Days</th>
        <th>Reason</th>
        <th>Status</th>
        <th>Admin Remark</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.leave_id</td>
            <td>@item.emp_id</td>
            <td>@item.emp_name</td>
            <td>@item.emp_department</td>
            <td>@item.leave_type</td>
            <td>@item.start_date.ToShortDateString()</td>
            <td>@item.end_date.ToShortDateString()</td>
            <td>@item.total_days</td>
            <td>@item.reason</td>
            <td>@item.status</td>
            <td>@item.admin_remark</td>

            <td>
                @if (item.status == "Pending")
                {
                    <form asp-controller="Admin"
                          asp-action="UpdateLeaveStatus"
                          asp-route-id="@ViewBag.AdminId"
                          method="post">

                        <input type="hidden"
                               name="leave_id"
                               value="@item.leave_id" />

                        <input type="text"
                               name="admin_remark"
                               placeholder="Admin remark" />

                        <br /><br />

                        <button type="submit"
                                name="status"
                                value="Approved">
                            Approve
                        </button>

                        <button type="submit"
                                name="status"
                                value="Rejected">
                            Reject
                        </button>

                    </form>
                }
                else
                {
                    <span>Already Processed</span>
                }
            </td>
        </tr>
    }

</table>

<br />

<a asp-controller="Admin"
   asp-action="DashboardLoad"
   asp-route-id="@ViewBag.AdminId">
    Back to Dashboard
</a>