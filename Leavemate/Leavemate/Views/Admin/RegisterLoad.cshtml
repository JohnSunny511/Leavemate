@model Leavemate.Models.Adminclss

<h2>Admin Registration</h2>

<form asp-controller="Admin"
      asp-action="Register_Click"
      method="post">

    <div>
        <label>Admin Name</label>
        <input asp-for="admin_name" required />
    </div>

    <br />

    <div>
        <label>Email</label>
        <input asp-for="admin_email" type="email" required />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="admin_password" type="password" required />
    </div>

    <br />

    <button type="submit">Register</button>

</form>

@if (TempData["msg"] != null)
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["msg"])));
    </script>
}