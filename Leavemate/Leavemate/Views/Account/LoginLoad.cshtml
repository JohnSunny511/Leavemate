@model Leavemate.Models.Login

<h2>Login</h2>

<form asp-controller="Account"
      asp-action="Login_Click"
      method="post">

    <div>
        <label>Username</label>
        <input asp-for="username" required />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="password" type="password" required />
    </div>

    <br />

    <br />

    <button type="submit">Login</button>

</form>

@if (TempData["msg"] != null)
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["msg"])));
    </script>
}

<br />

<a asp-controller="Employee" asp-action="RegisterLoad">
    Employee Registration
</a>

<br />

<a asp-controller="Admin" asp-action="RegisterLoad">
    Admin Registration
</a>